                    {
                      "id": "p3_tx",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "<p>Stanchezza → scelte sbagliate → senso di colpa → più stress → più cortisolo. Le diete tradizionali peggiorano il ciclo invece di spezzarlo.</p>",
