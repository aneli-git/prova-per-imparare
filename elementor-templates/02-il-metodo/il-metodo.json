                    {
                      "id": "p2_tx",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "<p>Con la peri-menopausa cambiano sonno, umore, distribuzione del peso e livelli di energia. Il corpo non risponde più come prima — perché non è più come prima.</p>",
                        "text_color": "#7a6435",
                        "typography_typography": "custom",
