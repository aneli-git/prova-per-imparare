                    {
                      "id": "p1_tx",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "<p>Lo stress cronico aumenta il cortisolo, che blocca il metabolismo, gonfia l'addome e alimenta la fame nervosa — indipendentemente da quello che mangi.</p>",
                        "text_color": "#7a6435",
                        "typography_typography": "custom",
