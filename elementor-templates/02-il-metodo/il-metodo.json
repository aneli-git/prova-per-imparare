                      "id": "p3_t",
                      "elType": "widget",
                      "widgetType": "heading",
                      "settings": {
                        "title": "Il loop non si spezza",
                        "header_size": "h3",
                        "align": "left",
                        "title_color": "#3d3530",
                        "typography_typography": "custom",
                        "typography_font_family": "Cormorant Garamond",
                        "typography_font_size": { "unit": "px", "size": 26 },
                        "typography_font_weight": "600"
                      }
