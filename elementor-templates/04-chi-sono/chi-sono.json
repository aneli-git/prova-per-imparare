                    "background_color": "#ffffff",
                    "border_radius": { "unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true },
                    "padding": { "unit": "px", "top": "28", "right": "24", "bottom": "28", "left": "24", "isLinked": false }
                  },
                  "elements": [
                    { "id": "f1_i", "elType": "widget", "widgetType": "heading", "settings": { "title": "🌿", "header_size": "p", "typography_font_size": { "unit": "px", "size": 28 } } },
                    { "id": "f1_t", "elType": "widget", "widgetType": "heading", "settings": { "title": "Il corpo sa.", "header_size": "h3", "title_color": "#3d3530", "typography_typography": "custom", "typography_font_family": "Cormorant Garamond", "typography_font_size": { "unit": "px", "size": 22 }, "typography_font_weight": "600" } },
                    { "id": "f1_d", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p>Il corpo non ti tradisce mai — ti manda segnali che nessuno ti ha insegnato a leggere. Il mio lavoro è darti quel linguaggio.</p>", "text_color": "#7a6435", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_size": { "unit": "px", "size": 14 }, "typography_line_height": { "unit": "em", "size": 1.7 } } }
                  ]
                },
                {
                  "id": "fil2",
                  "elType": "container",
                  "settings": {
                    "flex_direction": "column",
                    "align_items": "flex-start",
                    "gap": "narrow",
                    "width": { "unit": "%", "size": 30 },
                    "background_background": "classic",
                    "background_color": "#ffffff",
                    "border_radius": { "unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true },
                    "padding": { "unit": "px", "top": "28", "right": "24", "bottom": "28", "left": "24", "isLinked": false }
                  },
                  "elements": [
                    { "id": "f2_i", "elType": "widget", "widgetType": "heading", "settings": { "title": "🔬", "header_size": "p", "typography_font_size": { "unit": "px", "size": 28 } } },
                    { "id": "f2_t", "elType": "widget", "widgetType": "heading", "settings": { "title": "La scienza, non il mito.", "header_size": "h3", "title_color": "#3d3530", "typography_typography": "custom", "typography_font_family": "Cormorant Garamond", "typography_font_size": { "unit": "px", "size": 22 }, "typography_font_weight": "600" } },
                    { "id": "f2_d", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p>Niente magie, niente promesse. Tutto quello che insegno ha una base fisiologica spiegabile. Se non capisco perché funziona, non lo insegno.</p>", "text_color": "#7a6435", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_size": { "unit": "px", "size": 14 }, "typography_line_height": { "unit": "em", "size": 1.7 } } }
                  ]
                },
                {
                  "id": "fil3",
                  "elType": "container",
                  "settings": {
                    "flex_direction": "column",
                    "align_items": "flex-start",
