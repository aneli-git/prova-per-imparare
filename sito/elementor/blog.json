              "widgetType": "html",
              "settings": {
                "html": "<!-- HEADER -->\n<header class=\"site-header\">\n  <a href=\"index.html\" class=\"site-logo\">\n    <img src=\"img/logo-rinata.png\" alt=\"Metodo RINATA\">\n  </a>\n  <nav class=\"site-nav\">\n    <a href=\"index.html\">Home</a>\n    <a href=\"il-metodo.html\">Il Metodo</a>\n    <a href=\"percorsi.html\">Percorsi</a>\n    <a href=\"chi-sono.html\">Chi Sono</a>\n    <a href=\"blog.html\" class=\"active\">Blog</a>\n    <a href=\"contatti.html\">Contatti</a>\n    <a href=\"percorsi.html#reset\" class=\"btn-nav\">Reset 3 Giorni ↓</a>\n  </nav>\n  <button class=\"hamburger\" aria-label=\"Menu\"><span></span><span></span><span></span></button>\n</header>\n<nav class=\"mobile-menu\">\n  <a href=\"index.html\">Home</a>\n  <a href=\"il-metodo.html\">Il Metodo</a>\n  <a href=\"percorsi.html\">Percorsi</a>\n  <a href=\"chi-sono.html\">Chi Sono</a>\n  <a href=\"blog.html\">Blog</a>\n  <a href=\"contatti.html\">Contatti</a>\n  <a href=\"percorsi.html#reset\" class=\"btn-nav-mobile\">Reset 3 Giorni — Gratis</a>\n</nav>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <span class=\"tag\">Blog RINATA</span>\n  <h1>Benessere, ormoni<br><em>e vita vera</em></h1>\n  <p class=\"lead\">Articoli pratici su menopausa, Neuroyoga, nutrizione funzionale e psicobiologia — scritti da Marisa per le donne dai 40 anni.</p>\n  <div class=\"blog-filtri\">\n    <button class=\"filtro-btn active\">Tutti</button>\n    <button class=\"filtro-btn\">Nutrizione</button>\n    <button class=\"filtro-btn\">Neuroyoga</button>\n    <button class=\"filtro-btn\">Menopausa</button>\n    <button class=\"filtro-btn\">Psicobiologia</button>\n    <button class=\"filtro-btn\">Benessere</button>\n  </div>\n</section>\n\n<!-- ARTICOLO IN EVIDENZA -->\n<section class=\"section section-white\" style=\"padding-top:40px;\">\n  <div class=\"container\">\n    <div class=\"articolo-featured\">\n      <div class=\"art-img\">\n        <div class=\"img-placeholder\">\n          <svg width=\"48\" height=\"48\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"/></svg>\n          Immagine articolo in evidenza\n        </div>\n      </div>\n      <div class=\"art-body\">\n        <span class=\"tag\">In evidenza · Menopausa</span>\n        <h2>Perché dopo i 40 anni il tuo corpo cambia — e cosa fare davvero</h2>\n        <p class=\"art-excerpt\">I cambiamenti ormonali della peri-menopausa non sono una malattia. Sono una trasformazione. Scopri cosa sta succedendo nel tuo corpo e come il Metodo RINATA ti aiuta ad attraversarla con energia e serenità.</p>\n        <div class=\"art-meta\">Marisa Pagliuca · 8 min di lettura</div>\n        <a href=\"https://mentecorpoenergia.it/blog/\" target=\"_blank\" class=\"btn btn-primary\" style=\"align-self:flex-start;\">Leggi l'articolo →</a>\n      </div>\n    </div>\n\n    <!-- GRIGLIA ARTICOLI -->\n    <div class=\"blog-grid\">\n\n      <div class=\"art-card\">\n        <div class=\"art-img\">\n          <div class=\"img-placeholder\" style=\"min-height:180px;\">\n            <svg width=\"32\" height=\"32\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"/></svg>\n          </div>\n        </div>\n        <div class=\"art-body\">\n          <span class=\"tag\">Nutrizione</span>\n          <h3>5 alimenti che riducono il gonfiore in 24 ore</h3>\n          <p class=\"art-excerpt\">Il gonfiore addominale dopo i 40 anni è spesso ormonale. Questi 5 alimenti agiscono direttamente sull'infiammazione e ti aiutano a sentirti più leggera in tempi brevi.</p>\n          <div class=\"art-meta\">5 min di lettura</div>\n          <a href=\"https://mentecorpoenergia.it/blog/\" target=\"_blank\" class=\"art-link\">Leggi l'articolo <span>→</span></a>\n        </div>\n      </div>\n\n      <div class=\"art-card\">\n        <div class=\"art-img\">\n          <div class=\"img-placeholder\" style=\"min-height:180px;\">\n            <svg width=\"32\" height=\"32\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"/></svg>\n          </div>\n        </div>\n        <div class=\"art-body\">\n          <span class=\"tag\">Neuroyoga</span>\n          <h3>La routine mattutina di 10 minuti che cambia tutto</h3>\n          <p class=\"art-excerpt\">Dieci minuti al mattino con il Neuroyoga possono trasformare la qualità della tua giornata. Ecco la sequenza esatta che uso con le mie clienti.</p>\n          <div class=\"art-meta\">6 min di lettura</div>\n          <a href=\"https://mentecorpoenergia.it/blog/\" target=\"_blank\" class=\"art-link\">Leggi l'articolo <span>→</span></a>\n        </div>\n      </div>\n\n      <div class=\"art-card\">\n        <div class=\"art-img\">\n          <div class=\"img-placeholder\" style=\"min-height:180px;\">\n            <svg width=\"32\" height=\"32\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"/></svg>\n          </div>\n        </div>\n        <div class=\"art-body\">\n          <span class=\"tag\">Psicobiologia</span>\n          <h3>Fame nervosa: perché mangi quando sei stressata</h3>\n          <p class=\"art-excerpt\">La fame nervosa non è una questione di forza di volontà. È una risposta biologica allo stress. Capire il meccanismo è il primo passo per liberarsene.</p>\n          <div class=\"art-meta\">7 min di lettura</div>\n          <a href=\"https://mentecorpoenergia.it/blog/\" target=\"_blank\" class=\"art-link\">Leggi l'articolo <span>→</span></a>\n        </div>\n      </div>\n\n      <div class=\"art-card\">\n        <div class=\"art-img\">\n          <div class=\"img-placeholder\" style=\"min-height:180px;\">\n            <svg width=\"32\" height=\"32\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"/></svg>\n          </div>\n        </div>\n        <div class=\"art-body\">\n          <span class=\"tag\">Menopausa</span>\n          <h3>Vampate di calore: cause naturali e rimedi efficaci</h3>\n          <p class=\"art-excerpt\">Le vampate non sono inevitabili. Esistono strategie naturali — alimentari, posturali e di respirazione — che le riducono significativamente.</p>\n          <div class=\"art-meta\">6 min di lettura</div>\n          <a href=\"https://mentecorpoenergia.it/blog/\" target=\"_blank\" class=\"art-link\">Leggi l'articolo <span>→</span></a>\n        </div>\n      </div>\n\n      <div class=\"art-card\">\n        <div class=\"art-img\">\n          <div class=\"img-placeholder\" style=\"min-height:180px;\">\n            <svg width=\"32\" height=\"32\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"/></svg>\n          </div>\n        </div>\n        <div class=\"art-body\">\n          <span class=\"tag\">Benessere</span>\n          <h3>Dormire meglio dopo i 40: il protocollo serale RINATA</h3>\n          <p class=\"art-excerpt\">L'insonnia in menopausa è uno dei sintomi più debilitanti. Questo protocollo serale di 20 minuti aiuta il sistema nervoso a rilassarsi e prepara il corpo al sonno profondo.</p>\n          <div class=\"art-meta\">5 min di lettura</div>\n          <a href=\"https://mentecorpoenergia.it/blog/\" target=\"_blank\" class=\"art-link\">Leggi l'articolo <span>→</span></a>\n        </div>\n      </div>\n\n      <div class=\"art-card\">\n        <div class=\"art-img\">\n          <div class=\"img-placeholder\" style=\"min-height:180px;\">\n            <svg width=\"32\" height=\"32\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"/></svg>\n          </div>\n        </div>\n        <div class=\"art-body\">\n          <span class=\"tag\">Nutrizione</span>\n          <h3>Proteine e ormoni: perché ne hai bisogno di più dopo i 40</h3>\n          <p class=\"art-excerpt\">Dopo i 40 anni il fabbisogno proteico aumenta. Non per costruire muscoli, ma per supportare gli ormoni, la pelle e l'energia. Scopri quante ne servono davvero.</p>\n          <div class=\"art-meta\">6 min di lettura</div>\n          <a href=\"https://mentecorpoenergia.it/blog/\" target=\"_blank\" class=\"art-link\">Leggi l'articolo <span>→</span></a>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- NEWSLETTER -->\n    <div class=\"newsletter-box\">\n      <span class=\"tag\" style=\"color:rgba(242,232,213,0.7);\">Newsletter RINATA</span>\n      <h2>Ricevi i nuovi articoli ogni settimana</h2>\n      <p>Iscriviti alla newsletter e ricevi consigli pratici su benessere, ormoni e Neuroyoga — direttamente nella tua casella email.</p>\n      <form class=\"newsletter-form\" onsubmit=\"return false;\">\n        <input type=\"email\" placeholder=\"La tua email\" required>\n        <button type=\"submit\">Iscriviti</button>\n      </form>\n      <p style=\"font-size:0.72rem;margin-top:12px;color:rgba(242,232,213,0.5);\">Nessuno spam. Cancellazione in un clic.</p>\n    </div>\n\n  </div>\n</section>\n\n<!-- FOOTER -->\n<footer class=\"site-footer\">\n  <div class=\"footer-inner\">\n    <div class=\"footer-brand\">\n      <img src=\"img/logo-rinata.png\" alt=\"Metodo RINATA\" class=\"footer-logo\">\n      <p>Il Metodo RINATA 40+ accompagna le donne verso un benessere autentico e duraturo.</p>\n    </div>\n    <div class=\"footer-col\">\n      <h4>Navigazione</h4>\n      <a href=\"index.html\">Home</a>\n      <a href=\"il-metodo.html\">Il Metodo</a>\n      <a href=\"percorsi.html\">Percorsi</a>\n      <a href=\"chi-sono.html\">Chi Sono</a>\n      <a href=\"blog.html\">Blog</a>\n      <a href=\"contatti.html\">Contatti</a>\n    </div>\n    <div class=\"footer-col\">\n      <h4>Percorsi</h4>\n      <a href=\"percorsi.html#reset\">Reset 3 Giorni — Gratis</a>\n      <a href=\"percorsi.html#reset7\">Reset 7 Giorni</a>\n      <a href=\"percorsi.html#retreat\">Day Retreat</a>\n    </div>\n    <div class=\"footer-col\">\n      <h4>Contatti</h4>\n      <p>📧 <a href=\"mailto:info@metodorinata.it\">info@metodorinata.it</a></p>\n      <p>📸 <a href=\"https://www.instagram.com/marisapagliucarinata\" target=\"_blank\">@marisapagliucarinata</a></p>\n      <p>📍 Versilia, Toscana</p>\n    </div>\n  </div>\n  <div class=\"footer-bottom\">\n    <span>© 2026 Metodo RINATA — Marisa Pagliuca. Tutti i diritti riservati.</span>\n    <span><a href=\"privacy.html\">Privacy Policy</a> &nbsp;|&nbsp; <a href=\"cookie.html\">Cookie Policy</a></span>\n  </div>\n</footer>\n\n\n<script>\n  // Filtri blog\n  document.querySelectorAll('.filtro-btn').forEach(function(btn){\n    btn.addEventListener('click