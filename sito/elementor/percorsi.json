              "id": "6bb7f1b",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- HEADER -->\n<header class=\"site-header\">\n  <a href=\"index.html\" class=\"site-logo\">\n    <img src=\"img/logo-rinata.png\" alt=\"Metodo RINATA\">\n  </a>\n  <nav class=\"site-nav\">\n    <a href=\"index.html\">Home</a>\n    <a href=\"il-metodo.html\">Il Metodo</a>\n    <a href=\"percorsi.html\" class=\"active\">Percorsi</a>\n    <a href=\"chi-sono.html\">Chi Sono</a>\n    <a href=\"blog.html\">Blog</a>\n    <a href=\"contatti.html\">Contatti</a>\n    <a href=\"#reset\" class=\"btn-nav\">Reset 3 Giorni ↓</a>\n  </nav>\n  <button class=\"hamburger\" aria-label=\"Menu\"><span></span><span></span><span></span></button>\n</header>\n<nav class=\"mobile-menu\">\n  <a href=\"index.html\">Home</a>\n  <a href=\"il-metodo.html\">Il Metodo</a>\n  <a href=\"percorsi.html\">Percorsi</a>\n  <a href=\"chi-sono.html\">Chi Sono</a>\n  <a href=\"blog.html\">Blog</a>\n  <a href=\"contatti.html\">Contatti</a>\n  <a href=\"#reset\" class=\"btn-nav-mobile\">Reset 3 Giorni — Gratis</a>\n</nav>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <span class=\"tag\">I Percorsi RINATA</span>\n  <h1>Scegli il percorso<br><em>giusto per te</em></h1>\n  <p class=\"lead\">Ogni donna è diversa. Ogni percorso è pensato per incontrarti esattamente dove sei — online o in presenza.</p>\n  <div class=\"legenda\">\n    <div class=\"legenda-item\"><div class=\"legenda-dot\" style=\"background:#8a9e82;\"></div> Disponibile online</div>\n    <div class=\"legenda-item\"><div class=\"legenda-dot\" style=\"background:#9b8bb0;\"></div> Disponibile in presenza (Versilia)</div>\n    <div class=\"legenda-item\"><div class=\"legenda-dot\" style=\"background:#c9a84c;\"></div> Prossimamente</div>\n  </div>\n</section>\n\n<!-- CARDS PERCORSI -->\n<section class=\"section section-white\" id=\"reset\">\n  <div class=\"container\">\n    <div class=\"percorsi-grid\">\n\n      <!-- RESET 3 GIORNI -->\n      <div class=\"percorso-card\">\n        <div class=\"card-header-percorso verde\">\n          <div class=\"card-tag-percorso\">Punto di partenza</div>\n          <div class=\"card-title-percorso\">Reset 3 Giorni</div>\n          <div class=\"card-subtitle-percorso\">Il tuo primo passo verso il benessere</div>\n          <div class=\"card-price-percorso\">GRATIS</div>\n        </div>\n        <div class=\"card-body-percorso\">\n          <p class=\"card-desc-percorso\">Tre giorni di protocollo guidato per ridurre il gonfiore, calmare la fame nervosa e ritrovare energia. Il modo migliore per iniziare il tuo percorso con il Metodo RINATA.</p>\n          <ul class=\"card-features-percorso\">\n            <li>Piano alimentare anti-gonfiore 3 giorni</li>\n            <li>Routine mattutina Neuroyoga (10 min)</li>\n            <li>Tecniche anti-fame nervosa immediate</li>\n            <li>Checklist benessere quotidiana</li>\n            <li>Accesso alla community privata</li>\n          </ul>\n          <!-- FORM BREVO RESET 3 GIORNI -->\n          <form id=\"form-reset3\" style=\"display:flex;flex-direction:column;gap:10px;margin-top:auto;\">\n            <input type=\"email\" name=\"email\" placeholder=\"La tua email\" required\n              style=\"padding:13px 18px;border:1px solid rgba(138,158,130,0.4);border-radius:50px;font-size:0.88rem;font-family:inherit;background:#fff;color:var(--testo);outline:none;\">\n            <button type=\"submit\" class=\"card-btn-percorso verde\" style=\"border:none;cursor:pointer;\">Ricevi il Reset gratuito →</button>\n          </form>\n          <p style=\"font-size:0.7rem;color:rgba(61,53,48,0.45);margin-top:8px;\">Nessuno spam. Puoi cancellarti in qualsiasi momento.</p>\n          <div id=\"success-reset3\" style=\"display:none;background:var(--oro-light);border-radius:10px;padding:14px 16px;color:var(--testo-light);font-size:0.88rem;margin-top:10px;\">🌿 Perfetto! Controlla la tua email — ti ho inviato il Reset 3 Giorni. Benvenuta!</div>\n        </div>\n      </div>\n\n      <!-- RESET 7 GIORNI -->\n      <div class=\"percorso-card featured\" id=\"reset7\">\n        <div class=\"card-header-percorso oro\">\n          <div class=\"card-badge\">Offerta lancio</div>\n          <div class=\"card-tag-percorso\">Trasformazione profonda</div>\n          <div class=\"card-title-percorso\">Reset 7 Giorni</div>\n          <div class=\"card-subtitle-percorso\">Una settimana che cambia tutto</div>\n          <div class=\"card-price-percorso\">\n            <span style=\"text-decoration:line-through;opacity:.55;font-size:.75em;margin-right:.4em;\">€49</span>€37\n          </div>\n        </div>\n        <div class=\"card-body-percorso\">\n          <p class=\"card-desc-percorso\">Un percorso intensivo di 7 giorni con piano alimentare completo, sessioni di Neuroyoga guidate e supporto diretto. Per chi è pronta a fare il salto.</p>\n          <ul class=\"card-features-percorso\">\n            <li>Tutto il Reset 3 Giorni incluso</li>\n            <li>Piano alimentare esteso 7 giorni</li>\n            <li>Sessioni Neuroyoga guidate (video)</li>\n            <li>Supporto diretto via email</li>\n            <li>Workbook psicobiologia applicata</li>\n            <li>Accesso a vita ai materiali</li>\n          </ul>\n          <!-- FORM LISTA ATTESA RESET 7 GIORNI -->\n          <form id=\"form-reset7\" style=\"display:flex;flex-direction:column;gap:10px;margin-top:auto;\">\n            <input type=\"email\" name=\"email\" placeholder=\"La tua email\" required\n              style=\"padding:13px 18px;border:1px solid rgba(184,145,42,0.3);border-radius:50px;font-size:0.88rem;font-family:inherit;background:#fff;color:var(--testo);outline:none;\">\n            <button type=\"submit\" class=\"card-btn-percorso oro\" style=\"border:none;cursor:pointer;\">Avvisami al lancio →</button>\n          </form>\n          <p style=\"font-size:0.7rem;color:rgba(61,53,48,0.45);margin-top:8px;\">Sarai la prima a sapere quando è disponibile.</p>\n          <div id=\"success-reset7\" style=\"display:none;background:var(--oro-light);border-radius:10px;padding:14px 16px;color:var(--testo-light);font-size:0.88rem;margin-top:10px;\">✓ Sei in lista! Ti avviso appena il programma è pronto.</div>\n        </div>\n      </div>\n\n      <!-- DAY RETREAT -->\n      <div class=\"percorso-card\" id=\"retreat\">\n        <div class=\"card-header-percorso viola\">\n          <div class=\"card-badge\">In presenza · Versilia</div>\n          <div class=\"card-tag-percorso\">Immersione totale</div>\n          <div class=\"card-title-percorso\">Day Retreat</div>\n          <div class=\"card-subtitle-percorso\">Una giornata che trasforma</div>\n          <div class=\"card-price-percorso small\">Prossimamente</div>\n        </div>\n        <div class=\"card-body-percorso\">\n          <p class=\"card-desc-percorso\">Una giornata intera in un luogo speciale in Versilia. Neuroyoga, alimentazione consapevole, meditazione e connessione con altre donne nel percorso.</p>\n          <ul class=\"card-features-percorso\">\n            <li>Sessione Neuroyoga mattutina</li>\n            <li>Pranzo consapevole incluso</li>\n            <li>Workshop psicobiologia</li>\n            <li>Meditazione guidata</li>\n            <li>Gruppo piccolo (max 8 persone)</li>\n            <li>Materiali e workbook inclusi</li>\n          </ul>\n          <!-- FORM LISTA ATTESA DAY RETREAT -->\n          <form id=\"form-retreat\" style=\"display:flex;flex-direction:column;gap:10px;margin-top:auto;\">\n            <input type=\"email\" name=\"email\" placeholder=\"La tua email\" required\n              style=\"padding:13px 18px;border:1px solid rgba(155,139,176,0.35);border-radius:50px;font-size:0.88rem;font-family:inherit;background:#fff;color:var(--testo);outline:none;\">\n            <button type=\"submit\" class=\"card-btn-percorso viola\" style=\"border:none;cursor:pointer;\">Iscrivimi alla lista d'attesa →</button>\n          </form>\n          <p style=\"font-size:0.7rem;color:rgba(61,53,48,0.45);margin-top:8px;\">Ti contatto personalmente per i dettagli.</p>\n          <div id=\"success-retreat\" style=\"display:none;background:var(--oro-light);border-radius:10px;padding:14px 16px;color:var(--testo-light);font-size:0.88rem;margin-top:10px;\">✓ Perfetto! Ti contatto appena le date sono confermate.</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- COME FUNZIONA -->\n<section class=\"section section-crema\">\n  <div class=\"container\">\n    <div class=\"section-header\">\n      <span class=\"tag\">Come funziona</span>\n      <h2>Tre passi per iniziare</h2>\n      <p>Iniziare con il Metodo RINATA è semplice. Ecco cosa succede dal momento in cui ti iscrivi.</p>\n    </div>\n    <div class=\"grid-3\">\n      <div class=\"step-how\">\n        <div class=\"step-how-num\">1</div>\n        <div class=\"step-how-text\">\n          <h3>Ti iscrivi</h3>\n          <p>Scegli il percorso che fa per te e completi l'iscrizione. Per il Reset 3 Giorni è completamente gratuito.</p>\n        </div>\n      </div>\n      <div class=\"step-how\">\n        <div class=\"step-how-num\">2</div>\n        <div class=\"step-how-text\">\n          <h3>Ricevi i materiali</h3>\n          <p>Entro pochi minuti ricevi via email tutto il materiale: piano alimentare, video Neuroyoga e workbook.</p>\n        </div>\n      </div>\n      <div class=\"step-how\">\n        <div class=\"step-how-num\">3</div>\n        <div class=\"step-how-text\">\n          <h3>Inizi il tuo percorso</h3>\n          <p>Segui il protocollo giorno per giorno. Io sono con te — puoi scrivermi in qualsiasi momento.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- CTA -->\n<section class=\"section section-testo\" style=\"text-align:center;\">\n  <div class=\"container-sm\">\n    <span class=\"tag\" style=\"color:var(--oro);\">Non sai da dove iniziare?</span>\n    <h2 style=\"color:var(--oro-light);margin-bottom:16px;\">Scrivimi — ti aiuto a scegliere</h2>\n    <p style=\"color:rgba(242,232,213,0.8);margin-bottom:36px;\">Ogni donna ha la sua storia. Se non sai quale percorso fa per te, mandami un messaggio e ne parliamo.</p>\n    <a href=\"contatti.html\" class=\"btn btn-white\">Scrivimi →</a>\n  </div>\n</section>\n\n<!-- FOOTER -->\n<footer class=\"site-footer\">\n  <div class=\"footer-inner\">\n    <div class=\"footer-brand\">\n      <img src=\"img/logo-rinata.png\" alt=\"Metodo RINATA\" class=\"footer-logo\">\n      <p>Il Metodo RINATA 40+ accompagna le donne verso un benessere autentico e duraturo.</p>\n    </div>\n    <div class=\"footer-col\">\n      <h4>Navigazione</h4>\n      <a href=\"index.html\">Home</a>\n      <a href=\"il-metodo.html\">Il Metodo</a>\n      <a href=\"percorsi.html\">Percorsi</a>\n      <a href=\"chi-sono.html\">Chi Sono</a>\n      <a href=\"blog.html\">Blog</a>\n      <a href=\"contatti.html\">Contatti</a>\n    </div>\n    <div class=\"footer-col\">\n      <h4>Percorsi</h4>\n      <a href=\"#reset\">Reset 3 Giorni — Gratis</a>\n      <a href=\"#reset7\">Reset 7 Giorni</a>\n      <a href=\"#retreat\">Day Retreat</a>\n    </div>\n    <div class=\"footer-col\">\n      <h4>Contatti</h4>\n      <p>📧 <a href=\"mailto:info@metodorinata.it\">info@metodorinata.it</a></p>\n      <p>📸 <a href=\"https://www.instagram.com/marisapagliucarinata\" target=\"_blank\">@marisapagliucarinata</a></p>\n      <p>📍 Versilia, Toscana</p>\n    </div>\n  </div>\n  <div class=\"footer-bottom\">\n    <span>© 2026 Metodo RINATA — Marisa Pagliuca. Tutti i diritti riservati.</span>\n    <span><a href=\"privacy.html\">Privacy Policy</a> &nbsp;|&nbsp; <a href=\"cookie.html\">Cookie Policy</a></span>\n  </div>\n</footer>\n\n\n<script>\n// FORM RESET 3 GIORNI — BREVO\ndocument.getElementById('form-reset3').addEventListener('submit', function(e) {\n  e.preventDefault();\n  var email = this.querySelector('input[type=\"email\"]').value;\n  var btn = this.querySelector('button');\n  btn.textContent = 'Invio...';\n  btn.disabled = true;\n  fetch('https://formsubmit.co/ajax/info@metodorinata.it', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n    body: JSON.stringify({ email: email, _subject: 'Nuova iscrizione Reset 3 Giorni', fonte: 'Sito Web', _captcha: 'false' })\n  }).then(function() {\n    document.getElementById('success-reset3').style.display = 'block';\n    document.getElementById('form-reset3').style.display = 'none';\n  }).catch(function() {\n    btn.textContent = 'Ricevi il Reset gratuito →';\n    btn.disabled = false;\n    alert('Errore. Scrivi a info@metodorinata.it');\n  });\n});\n\n// FORM LISTA ATTESA RESET 7 GIORNI\ndocument.getElementById('form-reset7').addEventListener('submit', function(e) {\n  e.preventDefault();\n  var email = this.querySelector('input[type=\"email\"]').value;\n  var btn = this.querySelector('button');\n  btn.textContent = 'Invio...';\n  btn.disabled = true;\n  fetch('https://formsubmit.co/ajax/info@metodorinata.it', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n    body: JSON.stringify({ email: email, _subject: 'Lista attesa Reset 7 Giorni', _captcha: 'false' })\n  }).then(function() {\n    document.getElementById('success-reset7').style.display = 'block';\n    document.getElementById('form-reset7').style.display = 'none';\n  }).catch(function() {\n    btn.textContent = 'Avvisami al lancio →';\n    btn.disabled = false;\n  });\n});\n\n// FORM LISTA ATTESA DAY RETREAT\ndocument.getElementById('form-retreat').addEventListener('submit', function(e) {\n  e.preventDefault();\n  var email = this.querySelector('input[type=\"email\"]').value;\n  var btn = this.querySelector('button');\n  btn.textContent = 'Invio...';\n  btn.disabled = true;\n  fetch('https://formsubmit.co/ajax/info@metodorinata.it', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n    body: JSON.stringify({ email: email, _subject: 'Lista attesa Day Retreat', _captcha: 'false' })\n  }).then(function() {\n    document.getElementById('success-retreat').style.display = 'block';\n    document.getElementById('form-retreat').style.display = 'none';\n  }).catch(function() {\n    btn.textContent = 'Iscrivimi alla lista d\\'attesa →';\n    btn.disabled = false;\n  });\n});\n</script>"
              },
              "elements": []
            }
